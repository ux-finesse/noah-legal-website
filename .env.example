# Sanity — create a project at https://www.sanity.io/manage and paste its ID here.
# Until these are set, the site runs on the placeholder content in lib/fallback.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Sample content fills empty sections while building. Set to "off" on the live
# site so empty sections show their empty states instead of fictional samples.
SAMPLE_CONTENT=on

# Contact + newsletter forms (optional). With RESEND_API_KEY set, enquiries are emailed
# to CONTACT_TO_EMAIL via Resend; otherwise they are only logged on the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Only needed for `npm run seed` (Sanity → API → Tokens, Editor). Keep secret; never commit.
SANITY_WRITE_TOKEN=
